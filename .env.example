# Preferred shared lead system (server-only). Each project has its own token.
LEAD_API_URL=https://artcnnkhqprbzhfudenh.supabase.co/functions/v1/capture-lead
LEAD_API_TOKEN=

# ---------------------------------------------------------------- Supabase
# Where leads are stored. One shared `leads` table across every Team Arora
# landing page; this site stamps its own project slug on each row
# (see LEAD_PROJECT in lib/leads.ts).
#
# Shared schema is already provisioned in project artcnnkhqprbzhfudenh.
# Use project-scoped gateway settings above for new integrations.
#
# Project settings -> Data API -> Project URL
SUPABASE_URL=

# Project settings -> API keys -> service_role.
#
# BYPASSES ROW LEVEL SECURITY. Server-side only. Never prefix with
# NEXT_PUBLIC_, never paste into client code, and rotate it if it leaks —
# it can read every lead the brokerage has ever captured.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Salt for the stored IP hash so hashes cannot be matched across
# sites by rainbow table. Any random string.
LEAD_IP_SALT=

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Signs the cookie that unlocks the gated floor plan downloads. Must be at
# least 16 characters. The app refuses to serve in production without it —
# with a predictable secret anyone could forge a token and skip the form.
#
#   openssl rand -base64 32
ACCESS_SECRET=

# ---------------------------------------------------------------------------
# LEAD DELIVERY
# ---------------------------------------------------------------------------
# Where registrations are delivered.
#
# Optional extra delivery after confirmed Supabase storage.
# A failed database save returns 503 and does not unlock floor plans.
#
# Set it to a CRM intake endpoint (Follow Up Boss, Zapier, Make, or your own
# handler) and each valid lead is POSTed there as JSON:
#
#   { firstName, lastName, email, phone, isRealtor, budget, timeline,
#     receivedAt, source }
LEAD_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` on the webhook request.
LEAD_WEBHOOK_TOKEN=

# Signing key for the floor plan access cookie (lib/access.ts).
#
# Must be at least 16 characters. In development a fixed insecure fallback is
# used so the flow runs straight after `bun install`; in production the app
# refuses to start without this, because the fallback would let anyone forge a
# token and pull the plans without registering.
#
#   openssl rand -base64 32
ACCESS_SECRET=
